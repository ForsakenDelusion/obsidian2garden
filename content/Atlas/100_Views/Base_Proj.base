views:
  - type: kanban
    name: 项目看板
    filters:
      and:
        - file.inFolder("Effort/400_Projects")
        - type == "project"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
    cardOpenBehavior: modal
    showQuickAddButton: true
    showStandardAddButton: false
    quickAddChoice: Create_Proj
