views:
  - type: kanban
    name: 表格
    filters:
      or:
        - file.inFolder("Atlas/000_Notes")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - tags
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 10
    columnSize:
      file.name: 289
      note.tags: 253
  - type: cards
    name: 视图
