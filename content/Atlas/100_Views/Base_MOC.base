views:
  - type: kanban
    name: 视图
    filters:
      and:
        - file.inFolder("Atlas/000_Notes")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
    sort:
      - property: file.mtime
        direction: DESC
    newItemFolder: Toolkit/99_Buffer
    newCardsToTop: true
  - type: table
    name: 表格
